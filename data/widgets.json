        "4f7c794b": {
          "id": "4f7c794b",
          "title": "Яндекс Поиск",
          "type": "html",
          "content": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        body {\n            margin: 0;\n            padding: 10px;\n            font-family: Arial, sans-serif;\n            background: #fff;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            height: 100vh;\n            overflow: hidden;\n        }\n        .container {\n            width: 100%;\n            text-align: center;\n        }\n        .search-wrapper {\n            display: flex;\n            align-items: center;\n            background: #f2f2f2;\n            border-radius: 24px;\n            padding: 5px 15px;\n            border: 1px solid transparent;\n            transition: all 0.2s;\n        }\n        .search-wrapper:focus-within {\n            border-color: #ffcc00;\n            background: #fff;\n            box-shadow: 0 0 8px rgba(255, 204, 0, 0.3);\n        }\n        input {\n            border: none;\n            background: transparent;\n            outline: none;\n            padding: 10px;\n            width: 100%;\n            font-size: 16px;\n        }\n        button {\n            background: none;\n            border: none;\n            cursor: pointer;\n            font-weight: bold;\n            color: #000;\n            padding: 5px 10px;\n            font-size: 14px;\n        }\n        .logo {\n            font-weight: bold;\n            font-size: 24px;\n            margin-bottom: 15px;\n            display: block;\n            letter-spacing: -1px;\n        }\n        .logo span { color: #ffcc00; }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"logo\">Яндекс<span>.</span></div>\n        <form action=\"https://yandex.ru/search\" method=\"GET\" target=\"_blank\" class=\"search-wrapper\">\n            <input type=\"text\" name=\"text\" placeholder=\"Найдётся всё...\" required>\n            <button type=\"submit\">Найти</button>\n        </form>\n    </div>\n</body>\n</html>",
