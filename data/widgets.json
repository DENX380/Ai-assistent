        "a946e7a9": {
          "id": "a946e7a9",
          "title": "Смайлик-гифка",
          "type": "html",
          "content": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <style>\n        body {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            height: 100vh;\n            margin: 0;\n            background-color: #f0f2f5;\n            font-family: sans-serif;\n        }\n        .container {\n            text-align: center;\n            background: white;\n            padding: 20px;\n            border-radius: 15px;\n            box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n        }\n        #emoji {\n            font-size: 80px;\n            transition: transform 0.3s ease;\n            display: inline-block;\n        }\n        .pulse {\n            animation: pulse-animation 0.5s ease-in-out;\n        }\n        @keyframes pulse-animation {\n            0% { transform: scale(1); }\n            50% { transform: scale(1.2); }\n            100% { transform: scale(1); }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div id=\"emoji\">😊</div>\n    </div>\n\n    <script>\n        const emojiElement = document.getElementById('emoji');\n        const emojis = ['😊', '😠'];\n        let currentIndex = 0;\n\n        setInterval(() => {\n            currentIndex = (currentIndex + 1) % emojis.length;\n            emojiElement.textContent = emojis[currentIndex];\n            \n            // Добавляем эффект пульсации при смене\n            emojiElement.classList.remove('pulse');\n            void emojiElement.offsetWidth; // Trigger reflow\n            emojiElement.classList.add('pulse');\n        }, 2000);\n    </script>\n</body>\n</html>",
